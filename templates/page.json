      "blocks": {
        "custom_liquid_CiMqRA": {
          "type": "custom-liquid",
          "name": "t:names.custom_liquid",
          "settings": {
            "custom_liquid": "<section\n  class=\"gift-banner\"\n  style=\"background-color: {{ section.settings.section_bg }};\"\n>\n\n  {%- comment -%} ── Top bar: logo / tagline / Choose Gift CTA / menu icon ── {%- endcomment -%}\n  <div class=\"gift-banner__topbar\">\n\n    <a href=\"{{ routes.root_url }}\" class=\"gift-banner__logo\">\n      {{ section.settings.logo_text }}\n    </a>\n\n    {%- if section.settings.tagline_text != blank -%}\n      <p class=\"gift-banner__tagline\">{{ section.settings.tagline_text }}</p>\n    {%- endif -%}\n\n    <div class=\"gift-banner__topbar-actions\">\n\n      {%- if section.settings.choose_gift_label != blank -%}\n        <a\n          href=\"{{ section.settings.choose_gift_link | default: '#' }}\"\n          class=\"gift-banner__btn gift-banner__btn--accent\"\n          style=\"\n            --btn-bg: {{ section.settings.choose_gift_bg }};\n            --btn-color: {{ section.settings.choose_gift_text_color }};\n          \"\n        >\n          <span class=\"gift-banner__btn-label\">{{ section.settings.choose_gift_label }}</span>\n          <span class=\"gift-banner__btn-arrow\" aria-hidden=\"true\">&rarr;</span>\n        </a>\n      {%- endif -%}\n\n      <button type=\"button\" class=\"gift-banner__menu-icon\" aria-label=\"More options\">\n        &#8942;\n      </button>\n\n    </div>\n  </div>\n\n  {%- comment -%} ── Hero: illustration + heading + description + Shop Now CTA ── {%- endcomment -%}\n  <div class=\"gift-banner__hero\">\n\n    <div class=\"gift-banner__illustration\">\n      {%- if section.settings.banner_image != blank -%}\n        {{\n          section.settings.banner_image\n          | image_url: width: 1800\n          | image_tag:\n            loading: 'eager',\n            fetchpriority: 'high',\n            alt: section.settings.heading_text,\n            class: 'gift-banner__illustration-img'\n        }}\n      {%- endif -%}\n    </div>\n\n    <div class=\"gift-banner__content\">\n      {%- if section.settings.heading_text != blank -%}\n        <h1 class=\"gift-banner__heading\">{{ section.settings.heading_text }}</h1>\n      {%- endif -%}\n\n      {%- if section.settings.description_text != blank -%}\n        <div class=\"gift-banner__description\">{{ section.settings.description_text }}</div>\n      {%- endif -%}\n\n      {%- if section.settings.shop_now_label != blank -%}\n        <a\n          href=\"{{ section.settings.shop_now_link | default: '#' }}\"\n          class=\"gift-banner__btn gift-banner__btn--dark\"\n          style=\"\n            --btn-bg: {{ section.settings.shop_now_bg }};\n            --btn-color: {{ section.settings.shop_now_text_color }};\n          \"\n        >\n          <span class=\"gift-banner__btn-label\">{{ section.settings.shop_now_label }}</span>\n          <span class=\"gift-banner__btn-arrow\" aria-hidden=\"true\">&rarr;</span>\n        </a>\n      {%- endif -%}\n    </div>\n\n  </div>\n\n  {%- comment -%} ── Footer strip ── {%- endcomment -%}\n  {%- if section.settings.bottom_text != blank -%}\n    <div class=\"gift-banner__footer\">\n      <p class=\"gift-banner__footer-text\">{{ section.settings.bottom_text }}</p>\n    </div>\n  {%- endif -%}\n\n</section>"
          },

{{ 'header-custom.css' | asset_url | stylesheet_tag }}

<header class="custom-header">
  <div class="custom-header__container">
    
    <!-- Mobile Hamburger Toggle -->
    <button type="button" class="custom-header__mobile-toggle" id="HeaderMobileToggle" aria-label="Toggle navigation menu">
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
    </button>

    <!-- Logo -->
    <div class="custom-header__logo">
      <a href="{{ routes.root_url }}">
        <span class="custom-header__logo-text">{{ section.settings.logo_text | default: 'TISSO VISON' }}</span>
      </a>
    </div>

    <!-- Desktop Center Announcement -->
    <div class="custom-header__center">
      {% if section.settings.center_text != blank %}
        <p class="custom-header__announcement">{{ section.settings.center_text }}</p>
      {% endif %}
    </div>

    <!-- Desktop Right Action Button -->
    <div class="custom-header__right">
      {% if section.settings.button_label != blank %}
        <a href="{{ section.settings.button_link | default: '#' }}" class="custom-header__btn">
          <span>{{ section.settings.button_label }}</span>
          <span class="custom-header__btn-arrow">→</span>
        </a>
      {% endif %}
    </div>

  </div>

  <!-- Mobile Drawer -->
  <div class="custom-header__mobile-drawer" id="HeaderMobileDrawer">
    <div class="custom-header__mobile-content">
      {% if section.settings.center_text != blank %}
        <p class="custom-header__mobile-announcement">{{ section.settings.center_text }}</p>
      {% endif %}

      {% if section.settings.button_label != blank %}
        <a href="{{ section.settings.button_link | default: '#' }}" class="custom-header__btn custom-header__btn--mobile">
          <span>{{ section.settings.button_label }}</span>
          <span class="custom-header__btn-arrow">→</span>
        </a>
      {% endif %}
    </div>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const toggleBtn = document.getElementById('HeaderMobileToggle');
    const drawer = document.getElementById('HeaderMobileDrawer');
    
    if (toggleBtn && drawer) {
      toggleBtn.addEventListener('click', function() {
        toggleBtn.classList.toggle('is-active');
        drawer.classList.toggle('is-open');
      });
    }
  });
</script>

{% schema %}
{
  "name": "Custom Header",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text",
      "default": "TISSO VISON"
    },
    {
      "type": "text",
      "id": "center_text",
      "label": "Center Announcement Text",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Custom Header"
    }
  ]
}
{% endschema %}
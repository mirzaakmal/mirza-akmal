{{ 'product-grid.css' | asset_url | stylesheet_tag }}


{%- comment -%}
  Product Grid section — built entirely from scratch (no Dawn snippets/classes).
  Renders up to 6 blocks, each pointing at a merchant-selected product.
  Clicking the "+" button on a tile opens a shared popup (markup at the
  bottom of this file) which is populated dynamically via JS using the
  Storefront AJAX API (/products/{handle}.js and /cart/add.js).
{%- endcomment -%}


<section
  class="product-grid"
  id="ProductGrid-{{ section.id }}"
  data-product-grid
  data-money-format="{{ shop.money_format | escape }}"
  data-linked-product-handle="{{ section.settings.linked_product.handle }}"
  data-trigger-option-a="{{ section.settings.linked_trigger_option_a | escape }}"
  data-trigger-option-b="{{ section.settings.linked_trigger_option_b | escape }}"
>


  {%- if section.settings.heading != blank -%}
    <h2 class="product-grid__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}


  <div class="product-grid__items">
    {%- for block in section.blocks -%}
      {%- assign grid_product = block.settings.product -%}
      <div class="product-grid__item" {{ block.shopify_attributes }}>


        {%- if grid_product != blank -%}
          <div class="product-grid__image-wrap" data-product-handle="{{ grid_product.handle }}">
            {{
              grid_product.featured_image
              | image_url: width: 900
              | image_tag: loading: 'lazy', alt: grid_product.title, class: 'product-grid__image'
            }}


            <button
              type="button"
              class="product-grid__plus-btn"
              data-open-product-modal
              aria-label="Quick view {{ grid_product.title | escape }}"
            >
              <span aria-hidden="true">+</span>
            </button>
          </div>
        {%- else -%}
          <div class="product-grid__image-wrap product-grid__image-wrap--empty">
            <p>Select a product in the customizer</p>
          </div>
        {%- endif -%}


      </div>
    {%- endfor -%}
  </div>


  {%- comment -%} ── Shared quick-view popup (single instance per section) ── {%- endcomment -%}
  <div class="product-modal" data-product-modal>
  <div class="product-modal__overlay"></div>
  <div class="product-modal__dialog">
    <button class="product-modal__close" data-modal-close aria-label="Close">&times;</button>
   
    <div class="product-modal__top-section">
      <div class="product-modal__media">
        <img src="" alt="" data-modal-image class="product-modal__image">
      </div>
      <div class="product-modal__info">
        <h3 data-modal-title class="product-modal__title"></h3>
        <div data-modal-price class="product-modal__price"></div>
        <div data-modal-description class="product-modal__description"></div>
      </div>
    </div>


    <div data-modal-options class="product-modal__options"></div>


    <button data-add-to-cart class="product-modal__add-to-cart">
      <span>ADD TO CART</span>
      <span class="product-modal__add-arrow">⟶</span>
    </button>
    <div data-modal-message class="product-modal__message"></div>
  </div>
</div>


</section>


<script src="{{ 'product-grid.js' | asset_url }}" defer="defer"></script>


{% schema %}
{
  "name": "Product Grid",
  "tag": "section",
  "class": "section-product-grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop the Edit"
    },
    {
      "type": "header",
      "content": "Linked product rule"
    },
    {
      "type": "paragraph",
      "content": "When a customer adds a variant matching both trigger values below, this product is auto-added to their cart too."
    },
    {
      "type": "product",
      "id": "linked_product",
      "label": "Product to auto-add",
      "info": "e.g. Soft Winter Jacket"
    },
    {
      "type": "text",
      "id": "linked_trigger_option_a",
      "label": "Trigger option value 1",
      "default": "Black"
    },
    {
      "type": "text",
      "id": "linked_trigger_option_b",
      "label": "Trigger option value 2",
      "default": "Medium"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Product Grid",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}





